*.rej
*.log
tmp/
temp/
scratch/
.cache/

# Anything a contributor marks local stays local.
*.local
*.local.*
local/

# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
*.pem
*.key
credentials.json

# ---------------------------------------------------------------------------
# Model weights and token data
#
# SCAF audits checkpoints and reads .npy token dumps but should never carry
# them: they are inputs to an audit, not part of the framework. Keeping them
# out also stops a multi-GB checkpoint being committed by an errant `git add`.
# ---------------------------------------------------------------------------
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.npy
*.npz
checkpoints/
wandb/
lightning_logs/
runs/

# ---------------------------------------------------------------------------
# SCAF audit artifacts
# ---------------------------------------------------------------------------
*.scorecard.json
scaf_reports/
